      "css": ".ds-node{font-family:ui-sans-serif,system-ui,sans-serif;display:flex;align-items:center;gap:22px;text-align:left;background:transparent;border:0;border-radius:8px;color:var(--accent-deep,#075a34);font-size:14px;font-weight:700;padding:8px;cursor:pointer}.ds-hex{display:grid;place-items:center;width:70px;height:66px;background:var(--accent,#087f46);clip-path:polygon(50% 0,94% 24%,94% 76%,50% 100%,6% 76%,6% 24%)}.ds-hex svg{width:29px;height:29px;fill:none;stroke:#fff;stroke-width:1.7}.ds-node small{display:block;font-size:12px;font-weight:400;margin-top:6px}.ds-node:hover .ds-hex{background:var(--accent-deep,#075a34)}.ds-node:focus-visible{outline:3px solid var(--focus,#90541a);outline-offset:4px;}"
