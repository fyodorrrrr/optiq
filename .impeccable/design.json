      "html": "<section class=\"ds-preview\"><h3>Lab 6: Object detection</h3><p>Compare recorded detections and inspect training and evaluation results.</p><a href=\"#lab6\">Open lab \u2192</a></section>",
      "css": ".ds-preview{font-family:ui-sans-serif,system-ui,sans-serif;max-width:300px;background:var(--paper,#f7f7f5);color:var(--ink,#171717);border:0;border-radius:12px;padding:24px}.ds-preview h3{font-size:19px;line-height:1.4;font-weight:600;margin:0 0 22px}.ds-preview p{font-size:14px;line-height:1.65;color:var(--ink-soft,#656565);margin:0 0 22px}.ds-preview a{display:inline-flex;text-decoration:none;background:var(--accent,#087f46);color:#fff;padding:12px 18px;border-radius:8px;font-size:14px;font-weight:600}.ds-preview a:hover{background:var(--accent-deep,#075a34)}.ds-preview a:focus-visible{outline:3px solid var(--focus,#90541a);outline-offset:4px;}"
