      "html": "<article class=\"ds-card\"><h3>Pick an image.</h3><p>Use a sample, upload your own, or explore a prepared dataset.</p><svg viewBox=\"0 0 160 120\" aria-label=\"Illustrative emerald geometric scene\" role=\"img\"><rect width=\"160\" height=\"120\" fill=\"#e1f5e8\"/><rect x=\"14\" y=\"18\" width=\"54\" height=\"44\" fill=\"#087f46\"/><circle cx=\"115\" cy=\"39\" r=\"23\" fill=\"#a8ddbb\"/><path d=\"M16 104 44 65 72 104Z\" fill=\"#51a878\"/><path d=\"M72 104V67h73v37Z\" fill=\"#075a34\"/></svg></article>",
      "css": ".ds-card{font-family:ui-sans-serif,system-ui,sans-serif;max-width:300px;padding:28px 28px 24px;background:var(--paper-deep,#fff);color:var(--ink,#171717);border-radius:12px}.ds-card h3{font-size:25px;line-height:1.25;letter-spacing:-.025em;margin:0;font-weight:650}.ds-card p{font-size:16px;line-height:1.7;color:var(--ink-soft,#656565);margin:20px 0 24px}.ds-card svg{display:block;width:100%;height:160px}"
