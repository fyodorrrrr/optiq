[Unit]
Description=Check Optiq API readiness and storage
After=optiq-api.service

[Service]
Type=oneshot
User=optiq
Group=optiq
WorkingDirectory=/opt/optiq/backend
ExecStart=/opt/optiq/backend/.venv/bin/python scripts/monitor.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LogNamespace=optiq
